# DATABASE CONFIGURATION (LIBERO-WEB)
# Este bloque tiene como objetivo servir de plantilla para la base de datos MySQL de LiberoWeb
DB_TYPE = mysql
DB_HOST = localhost
DB_PORT = 3306
DB_USER = root
DB_PASSWORD = tu_password_mysql
DB_DATABASE = liberoweb
DB_SYNCHRONIZE = true

# JWT AUTHENTICATION
# Este bloque tiene como objetivo servir de plantilla para la clave secreta JWT
JWT_SECRET = liberoweb_jwt_secret_key_2026
EXPIRES_IN = 8h

# SERVER PORT & FRONTEND
PORT = 3000
FRONTEND_URL = http://localhost:4200

# FACEBOOK META GRAPH API (OFICIAL) / RSS (RESPALDO)
# FACEBOOK_PAGE_ID: ID numérico de tu Fan Page (ej. 102938475612345 o tu alias)
FACEBOOK_PAGE_ID = LiberoCobreCol
# FACEBOOK_ACCESS_TOKEN: Token de acceso de página (Page Access Token) generado en developers.facebook.com
FACEBOOK_ACCESS_TOKEN = tu_facebook_page_access_token
# FACEBOOK_RSS_URL: Opcional como respaldo secundario si no se usa Meta Graph API
FACEBOOK_RSS_URL = https://rss.app/feeds/tu_feed_id.xml

SMTP_HOST = smtp.gmail.com
SMTP_PORT = 587
SMTP_SECURE = false
SMTP_USER = 
SMTP_PASS = 
SMTP_FROM = "Líbero Cobre" <notificaciones@liberocobre.online>