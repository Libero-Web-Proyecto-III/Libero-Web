# DATABASE CONFIGURATION (LIBERO-WEB)
# Este bloque tiene como objetivo servir de plantilla para la base de datos MySQL de LiberoWeb
DB_TYPE = mysql
DB_HOST = localhost
DB_PORT = 3306
DB_USER = root
DB_PASSWORD = tu_password_mysql
DB_DATABASE = liberoweb
DB_SYNCHRONIZE = true

# JWT AUTHENTICATION
# Este bloque tiene como objetivo servir de plantilla para la clave secreta JWT
JWT_SECRET = liberoweb_jwt_secret_key_2026
EXPIRES_IN = 8h

# SERVER PORT
PORT = 3000

# FACEBOOK RSS / GRAPH API (OPCIONAL)
FACEBOOK_PAGE_ID = LiberoCobreCol
FACEBOOK_ACCESS_TOKEN = tu_facebook_page_access_token
FACEBOOK_RSS_URL = https://rss.app/feeds/tu_feed_id.xml